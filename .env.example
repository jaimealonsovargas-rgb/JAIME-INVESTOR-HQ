# EJEMPLO SIN SECRETOS. Crear .env LOCAL (ignorado por Git).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ENVIRONMENT=paper
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENVIRONMENT=demo
TWELVE_DATA_API_KEY=
FRED_API_KEY=
LIVE_TRADING_ENABLED=false
ALPACA_BASE_URL=https://paper-api.alpaca.markets
TRADING212_BASE_URL=https://demo.trading212.com/api/v0
DATABASE_URL=sqlite:///./data/jaime_hq.db
# P2: fuentes públicas bajo demanda; desactivar globalmente o por ID si se desea.
DATA_PUBLIC_ENABLED=true
DATA_DISABLED_SOURCES=
# Identificación para SEC: nombre de aplicación y correo de contacto, solo local.
# Tras cambiar .env, reiniciar backend; no publicar el contacto ni las claves.
SEC_CONTACT=
BEA_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINGECKO_DEMO_API_KEY=
OPENFIGI_API_KEY=
FMP_API_KEY=
MASSIVE_API_KEY=
TIINGO_API_KEY=
# Claves opcionales locales; no añadir VITE_* ni cambiar los hosts paper/demo.
AGENT_REACH_PUBLIC_ENABLED=false
VIBE_DATA_ADAPTER_ENABLED=false
LIQUID_PUBLIC_READONLY_ENABLED=false
# P4: revisión descriptiva autónoma (una fuente autorizada, cero inferencias).
# Pausa persistente también disponible desde Sistemas/Research.
AUTONOMY_ENABLED=true
AUTONOMY_INTERVAL_SECONDS=86400
AUTONOMY_STARTUP_DELAY_SECONDS=30
AUTONOMY_SOURCE=A21

# B2.3: captacion privada IEX y lectura PAPER por solicitud; sin ordenes.
ALPACA_MARKET_ENABLED=true

# B2.5: generadas localmente por scripts/n8n_shadow.py prepare. Nunca usar VITE_*.
JAIME_CYCLE_TOKEN=
N8N_ENCRYPTION_KEY=
N8N_NODE_PATH=

# B2: presupuestos locales en MiB, requieren reiniciar el backend.
# No son espacio preasignado ni autorizan borrar evidencias. Aviso desde el 80%.
STORAGE_DATA_LIMIT_MIB=4096
STORAGE_OUTPUT_LIMIT_MIB=12288
STORAGE_TOTAL_LIMIT_MIB=16384
STORAGE_MIN_FREE_MIB=5120
STORAGE_UNIT_RESERVE_MIB=512
